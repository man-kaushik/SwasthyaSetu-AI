# ---------------------------------------------------------------------------
# SwasthyaSetu AI - functions runtime configuration
# Copy to `.env` (git-ignored) for local runs / Cloud Functions. Every value
# is optional: the API degrades gracefully when an integration is missing.
# ---------------------------------------------------------------------------

# Google Cloud project that hosts dataset `swasthya_ai`
# (falls back to the project id inside GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_CLOUD_PROJECT=swasthyasetu-ai-7b4e6

# BigQuery telemetry targets used by POST /phcUpdate and GET /dashboard
BQ_DATASET=swasthya_ai
BQ_LOCATION=US

# Service account with roles/bigquery.dataEditor + roles/bigquery.jobUser
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json

# Gemini (POST /explainAlert + AI translation tier)
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash
